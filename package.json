{
  "name": "dsh-session-rewind",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "会话内回退插件：通过 /rewind 命令将当前对话折叠回退到之前的指定回合，不创建新会话，原地使用 surface replace 折叠尾部消息。In-session rewind plugin: fold the current conversation back to a previous turn via /rewind command, using in-place surface replace instead of forking a new session.",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:inline": "node --experimental-test-isolation=none --test \"tests/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "react": "^18.2.0"
  }
}
